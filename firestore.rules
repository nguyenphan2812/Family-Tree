rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the current user is an authorized editor
    function isEditor(familyId) {
      return request.auth != null &&
        request.auth.token.email != null &&
        (
          request.auth.token.email in get(/databases/$(database)/documents/families/$(familyId)).data.editorEmails ||
          request.auth.token.email.lower() in get(/databases/$(database)/documents/families/$(familyId)).data.editorEmails
        );
    }

    match /families/{familyId} {
      // Public read access for the family tree
      allow read: if true;
      // Allow editors to update the family metadata or editor list
      allow write: if request.auth != null &&
        request.auth.token.email != null &&
        (
          resource == null ||
          request.auth.token.email in resource.data.editorEmails ||
          request.auth.token.email.lower() in resource.data.editorEmails
        );

      match /people/{personId} {
        allow read: if true;
        allow write: if isEditor(familyId);
      }

      match /marriages/{marriageId} {
        allow read: if true;
        allow write: if isEditor(familyId);
      }
    }
  }
}
